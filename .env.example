
# Which LLM backend to use: "groq" (free, 100K tokens/day) or "bedrock" (AWS
# credits, no daily cap). Both run llama-3.3-70b, so numbers stay comparable.
LLM_PROVIDER=groq

GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

# Bedrock accepts either your normal AWS credentials (~/.aws or AWS_ACCESS_KEY_ID)
# or a Bedrock API key, which is one string you generate in the Bedrock console:
# AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=us.meta.llama3-3-70b-instruct-v1:0
AWS_REGION=us-east-1

# Which model grades the answers, when it should not be the one that wrote them.
# Read by demo.py (--judge-model); the scripts/ set it per-process instead. Leaving it
# empty means the generator grades itself: F1 0.41, against 0.54 for claude-haiku.
JUDGE_MODEL=

DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

WEAVIATE_URL=
WEAVIATE_API_KEY=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

HYBRID_ALPHA=0.6

# Cross-encoder reranking (src/retrieval/rerank.py). RERANK_POOL is how many
# first-stage candidates get re-scored; RERANK_BASE is which retriever supplies them.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL=20
RERANK_BASE=hybrid
