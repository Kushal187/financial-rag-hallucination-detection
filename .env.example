LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Bedrock uses your AWS credentials, or set a Bedrock API key instead of them:
# AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL=us.meta.llama3-3-70b-instruct-v1:0
AWS_REGION=us-east-1

# Leave empty and the generator grades its own answers.
# Or use `us.anthropic.claude-haiku-4-5-20251001-v1:0` so the generator and judge are different models, which is better.
JUDGE_MODEL=

WEAVIATE_URL=
WEAVIATE_API_KEY=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

HYBRID_ALPHA=0.6
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL=20
RERANK_BASE=hybrid
